# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Model Configuration
# MODEL_MODE can be "mock" or "real"
MODEL_MODE=mock
MODEL_PATH=./models/model.pkl

# CORS Configuration
# Comma-separated list of allowed origins (e.g., chrome-extension://..., http://localhost:3000)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
